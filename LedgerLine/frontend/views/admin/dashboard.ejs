<% layout('layouts/boilerplate') %>

<div class="dashboard-wrapper">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-content">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
      <div>
        <h3 class="fw-bold mb-1">Administrative Control Center</h3>
        <p class="text-muted small mb-0">System-wide monitoring, user management, and security review</p>
      </div>
      <div class="d-flex gap-2">
        <a href="/admin/users" class="btn btn-outline-primary btn-sm"><i class="bi bi-people me-1"></i> Users</a>
        <a href="/admin/accounts" class="btn btn-outline-secondary btn-sm"><i class="bi bi-wallet2 me-1"></i> Accounts</a>
        <a href="/admin/transactions" class="btn btn-primary-ll btn-sm"><i class="bi bi-receipt me-1"></i> Transactions</a>
      </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
      <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
          <div>
            <span class="text-muted small fw-semibold">TOTAL USERS</span>
            <h3 class="fw-bold text-dark mt-1 mb-0"><%= stats.totalUsers %></h3>
          </div>
          <div class="stat-icon stat-icon-primary">
            <i class="bi bi-people-fill"></i>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
          <div>
            <span class="text-muted small fw-semibold">TOTAL ACCOUNTS</span>
            <h3 class="fw-bold text-dark mt-1 mb-0"><%= stats.totalAccounts %></h3>
          </div>
          <div class="stat-icon stat-icon-success">
            <i class="bi bi-wallet-fill"></i>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
          <div>
            <span class="text-muted small fw-semibold">SYSTEM TRANSACTIONS</span>
            <h3 class="fw-bold text-dark mt-1 mb-0"><%= stats.totalTransactions %></h3>
          </div>
          <div class="stat-icon stat-icon-warning">
            <i class="bi bi-arrow-left-right"></i>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
          <div>
            <span class="text-muted small fw-semibold">REFUSED / SUSPICIOUS</span>
            <h3 class="fw-bold text-danger mt-1 mb-0"><%= stats.suspiciousRefusedCount %></h3>
          </div>
          <div class="stat-icon stat-icon-danger">
            <i class="bi bi-shield-exclamation"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Liquidity Banner -->
    <div class="card card-ll border-0 shadow-sm p-4 mb-4 bg-white">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <span class="text-muted small fw-semibold text-uppercase">Total System Liquid Balances (Conservation Protected)</span>
          <h2 class="display-6 fw-bold currency-inr text-success mt-1 mb-0"><%= stats.formattedActiveBalance %></h2>
        </div>
        <span class="badge bg-success-subtle text-success fs-6 px-3 py-2">
          <i class="bi bi-check2-circle me-1"></i> Balance Invariant Verified
        </span>
      </div>
    </div>

    <div class="row g-4">
      <!-- Recent Global Transactions -->
      <div class="col-lg-7">
        <div class="card card-ll border-0 shadow-sm h-100">
          <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Recent Global Transactions</h5>
            <a href="/admin/transactions" class="text-decoration-none small fw-semibold">View All &rarr;</a>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-ll table-hover mb-0">
                <thead>
                  <tr>
                    <th>Ref</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Initiator</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (recentTransactions && recentTransactions.length > 0) { %>
                    <% recentTransactions.forEach(t => { %>
                      <tr>
                        <td><span class="font-monospace text-muted small"><%= t.transactionReference %></span></td>
                        <td>
                          <span class="badge bg-light text-dark border small"><%= t.type %></span>
                        </td>
                        <td class="currency-inr fw-bold"><%= t.formattedAmount %></td>
                        <td>
                          <span class="badge <%= t.status === 'SUCCESS' ? 'badge-status-active' : 'badge-status-closed' %>">
                            <%= t.status %>
                          </span>
                        </td>
                        <td class="small"><%= t.initiatedBy ? t.initiatedBy.username : 'System' %></td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="text-center py-4 text-muted">No transactions recorded yet.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Refused / Suspicious Activity Review -->
      <div class="col-lg-5">
        <div class="card card-ll border-0 shadow-sm h-100">
          <div class="card-header bg-white border-0 py-3">
            <h5 class="fw-bold mb-0 text-danger"><i class="bi bi-shield-exclamation me-1"></i> Security & Refusal Audit Log</h5>
          </div>
          <div class="card-body p-0">
            <div class="list-group list-group-flush">
              <% if (recentRefusedEntries && recentRefusedEntries.length > 0) { %>
                <% recentRefusedEntries.forEach(entry => { %>
                  <div class="list-group-item py-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="badge bg-danger">REFUSED</span>
                      <span class="text-muted small"><%= new Date(entry.timestamp).toLocaleString() %></span>
                    </div>
                    <div class="fw-semibold text-dark small"><%= entry.description %></div>
                    <div class="text-muted small mt-1 font-monospace">
                      A/C: <%= entry.accountNumber %> | User: <%= entry.initiatedBy ? entry.initiatedBy.username : 'N/A' %>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="text-center py-4 text-muted small">
                  <i class="bi bi-shield-check fs-2 text-success d-block mb-1"></i>
                  Zero refused or unauthorized transaction attempts logged.
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

