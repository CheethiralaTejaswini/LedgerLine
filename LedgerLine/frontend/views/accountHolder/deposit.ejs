<% layout('layouts/boilerplate') %>

<div class="dashboard-wrapper">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-content">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card card-ll border-0 shadow-sm p-4 p-md-5">
          <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
            <div class="stat-icon stat-icon-success">
              <i class="bi bi-box-arrow-in-down-right"></i>
            </div>
            <div>
              <h4 class="fw-bold mb-1">Deposit Funds</h4>
              <p class="text-muted small mb-0">Add money to your account with instant atomic balance credit</p>
            </div>
          </div>

          <form action="/transactions/deposit" method="POST" class="transaction-form" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" id="idempotencyKey" name="idempotencyKey" value="<%= idempotencyKey %>">

            <div class="mb-4">
              <label for="accountId" class="form-label fw-semibold">Destination Account</label>
              <select class="form-select form-select-lg" id="accountId" name="accountId" required>
                <% if (accounts && accounts.length > 0) { %>
                  <% accounts.forEach(acc => { %>
                    <option value="<%= acc._id %>" <%= selectedAccountId && selectedAccountId.toString() === acc._id.toString() ? 'selected' : '' %>>
                      <%= acc.accountNumber %> (<%= acc.accountType %>) – Available: <%= acc.formattedBalance %>
                    </option>
                  <% }) %>
                <% } else { %>
                  <option disabled selected>No active accounts available</option>
                <% } %>
              </select>
            </div>

            <div class="mb-4">
              <label for="amount" class="form-label fw-semibold">Deposit Amount</label>
              <div class="input-group input-group-lg">
                <span class="input-group-text bg-light fw-bold">₹</span>
                <input type="number" class="form-control" id="amount" name="amount" min="1" step="0.01" max="5000000" placeholder="0.00" required>
              </div>
              <div class="form-text small">Enter amount in INR (minimum ₹ 1.00, maximum ₹ 50,00,000.00 per transaction).</div>
            </div>

            <div class="mb-4">
              <label for="description" class="form-label fw-semibold">Note / Description (Optional)</label>
              <input type="text" class="form-control" id="description" name="description" placeholder="e.g. Salary credit, Cash deposit" maxlength="255">
            </div>

            <div class="alert alert-light border p-3 small text-muted mb-4">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold text-dark"><i class="bi bi-key-fill text-primary"></i> Idempotency Lock Key:</span>
                <span class="font-monospace small text-primary"><%= idempotencyKey %></span>
              </div>
              Duplicate submissions with this key will not execute double deposits.
            </div>

            <div class="d-flex flex-wrap justify-content-between gap-2">
              <a href="/dashboard" class="btn btn-outline-secondary px-4">Cancel</a>
              <div class="d-flex gap-2">
                <button type="button" id="btn-razorpay-deposit" class="btn btn-outline-primary px-4">
                  <i class="bi bi-credit-card me-1"></i> Pay via Razorpay
                </button>
                <button type="submit" class="btn btn-primary-ll px-4">
                  <i class="bi bi-check-circle me-1"></i> Confirm Direct Deposit
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

