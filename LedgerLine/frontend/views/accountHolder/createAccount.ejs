<% layout('layouts/boilerplate') %>

<div class="dashboard-wrapper">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-content">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card card-ll border-0 shadow-sm p-4 p-md-5">
          <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
            <div class="stat-icon stat-icon-primary">
              <i class="bi bi-wallet2"></i>
            </div>
            <div>
              <h4 class="fw-bold mb-1">Open a New Account</h4>
              <p class="text-muted small mb-0">Provision an individual savings, current, or business portfolio</p>
            </div>
          </div>

          <form action="/accounts" method="POST" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-4">
              <label for="accountType" class="form-label fw-semibold">Account Category</label>
              <select class="form-select form-select-lg" id="accountType" name="accountType" required>
                <option value="SAVINGS" selected>Savings Account – Standard interest-bearing individual account</option>
                <option value="CURRENT">Current Account – Commercial account with unlimited daily transactions</option>
                <option value="BUSINESS">Business Account – Institutional account with high-volume thresholds</option>
              </select>
            </div>

            <div class="mb-4">
              <label for="initialDeposit" class="form-label fw-semibold">Initial Opening Deposit (Optional)</label>
              <div class="input-group input-group-lg">
                <span class="input-group-text bg-light fw-bold">₹</span>
                <input type="number" class="form-control" id="initialDeposit" name="initialDeposit" min="0" step="0.01" placeholder="0.00">
              </div>
              <div class="form-text small">Enter amount in INR. Initial balance will be booked to the append-only ledger automatically.</div>
            </div>

            <div class="alert alert-light border p-3 small text-muted mb-4">
              <h6 class="fw-bold text-dark mb-1"><i class="bi bi-info-circle me-1"></i> Account Provisioning Rules</h6>
              Every account is assigned an immutable 12-digit account number with guaranteed uniqueness across the cluster. Balances are strictly maintained in integer paise.
            </div>

            <div class="d-flex justify-content-between">
              <a href="/dashboard" class="btn btn-outline-secondary px-4">Cancel</a>
              <button type="submit" class="btn btn-accent-ll px-4">
                <i class="bi bi-check-lg me-1"></i> Provision Account
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

