<% layout('layouts/boilerplate') %>

<div class="dashboard-wrapper">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-content">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card card-ll border-0 shadow-sm p-4 p-md-5">
          <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
            <div class="stat-icon stat-icon-danger">
              <i class="bi bi-box-arrow-up-left"></i>
            </div>
            <div>
              <h4 class="fw-bold mb-1">Withdraw Funds</h4>
              <p class="text-muted small mb-0">Withdraw money with concurrency protection against overdrafts</p>
            </div>
          </div>

          <% 
            let currentSelected = accounts.find(a => selectedAccountId && selectedAccountId.toString() === a._id.toString()) || accounts[0];
            let activeBalancePaise = currentSelected ? currentSelected.balance : 0;
          %>

          <form action="/transactions/withdraw" method="POST" class="transaction-form form-withdraw" data-balance="<%= activeBalancePaise %>" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" id="idempotencyKey" name="idempotencyKey" value="<%= idempotencyKey %>">

            <div class="mb-4">
              <label for="accountId" class="form-label fw-semibold">Source Account</label>
              <select class="form-select form-select-lg" id="accountId" name="accountId" onchange="window.location.href='/transactions/withdraw?account=' + this.value" required>
                <% if (accounts && accounts.length > 0) { %>
                  <% accounts.forEach(acc => { %>
                    <option value="<%= acc._id %>" <%= currentSelected && currentSelected._id.toString() === acc._id.toString() ? 'selected' : '' %>>
                      <%= acc.accountNumber %> (<%= acc.accountType %>) – Available: <%= acc.formattedBalance %>
                    </option>
                  <% }) %>
                <% } else { %>
                  <option disabled selected>No active accounts available</option>
                <% } %>
              </select>
            </div>

            <div class="mb-4">
              <label for="amount" class="form-label fw-semibold">Withdrawal Amount</label>
              <div class="input-group input-group-lg">
                <span class="input-group-text bg-light fw-bold">₹</span>
                <input type="number" class="form-control" id="amount" name="amount" min="1" step="0.01" max="5000000" placeholder="0.00" required>
              </div>
              <div id="balance-preview"></div>
              <div class="form-text small">Available liquid balance: <strong><%= currentSelected ? currentSelected.formattedBalance : '₹ 0.00' %></strong>. Balances cannot become negative under any concurrent load.</div>
            </div>

            <div class="mb-4">
              <label for="description" class="form-label fw-semibold">Purpose / Reference (Optional)</label>
              <input type="text" class="form-control" id="description" name="description" placeholder="e.g. ATM cash withdrawal, Rent payment" maxlength="255">
            </div>

            <div class="alert alert-light border p-3 small text-muted mb-4">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold text-dark"><i class="bi bi-shield-check text-success"></i> Concurrency Lock:</span>
                <span class="font-monospace small text-primary"><%= idempotencyKey %></span>
              </div>
              Atomic query locks guarantee that simultaneous requests cannot overdraw the account.
            </div>

            <div class="d-flex justify-content-between">
              <a href="/dashboard" class="btn btn-outline-secondary px-4">Cancel</a>
              <button type="submit" class="btn btn-danger px-4">
                <i class="bi bi-cash-stack me-1"></i> Confirm Withdrawal
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

