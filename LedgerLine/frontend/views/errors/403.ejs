<% layout('layouts/boilerplate') %>

<div class="container py-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card card-ll border-0 shadow-sm p-4 p-md-5">
        <div class="stat-icon stat-icon-danger mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2rem;">
          <i class="bi bi-shield-lock"></i>
        </div>
        <h2 class="fw-bold text-danger">403 – Access Denied</h2>
        <p class="text-muted mt-2 mb-4">
          <%= typeof message !== 'undefined' ? message : 'You do not have administrative or ownership permission to access this resource or account.' %>
        </p>
        <div class="d-flex justify-content-center gap-2">
          <a href="/dashboard" class="btn btn-primary-ll">
            <i class="bi bi-speedometer2 me-1"></i> Return to Dashboard
          </a>
          <a href="/" class="btn btn-outline-secondary">
            <i class="bi bi-house me-1"></i> Home
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

