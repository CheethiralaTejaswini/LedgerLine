<% layout('layouts/boilerplate') %>

<div class="container py-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card card-ll border-0 shadow-sm p-4 p-md-5">
        <div class="stat-icon stat-icon-danger mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2rem;">
          <i class="bi bi-exclamation-triangle"></i>
        </div>
        <h2 class="fw-bold text-danger"><%= typeof statusCode !== 'undefined' ? statusCode : '500' %> – Server Error</h2>
        <p class="text-muted mt-2 mb-4">
          <%= typeof message !== 'undefined' ? message : 'A secure rollback was initiated to protect financial consistency.' %>
        </p>

        <% if (typeof stack !== 'undefined' && stack) { %>
          <div class="text-start bg-light p-3 rounded small mb-4 font-monospace" style="max-height: 180px; overflow-y: auto;">
            <pre class="mb-0"><%= stack %></pre>
          </div>
        <% } %>

        <div class="d-flex justify-content-center gap-2">
          <a href="/dashboard" class="btn btn-primary-ll">
            <i class="bi bi-speedometer2 me-1"></i> Dashboard
          </a>
          <a href="/" class="btn btn-outline-secondary">
            <i class="bi bi-house me-1"></i> Home
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

