<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top py-2 shadow-sm">
  <div class="container-fluid px-lg-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <i class="bi bi-shield-check fs-3"></i>
      <span class="fs-4">LedgerLine</span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ledgerNavbar" aria-controls="ledgerNavbar" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-indicator"><i class="bi bi-list fs-2"></i></span>
    </button>

    <div class="collapse navbar-collapse" id="ledgerNavbar">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% if (currUser) { %>
          <li class="nav-item">
            <a class="nav-link <%= currentPath.startsWith('/dashboard') || currentPath.startsWith('/admin/dashboard') || currentPath.startsWith('/auditor/dashboard') ? 'active' : '' %>" href="/dashboard">
              <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
          </li>

          <% if (currUser.role === 'ACCOUNT_HOLDER') { %>
            <li class="nav-item">
              <a class="nav-link <%= currentPath.startsWith('/transactions/deposit') ? 'active' : '' %>" href="/transactions/deposit">
                <i class="bi bi-arrow-down-circle me-1"></i> Deposit
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= currentPath.startsWith('/transactions/withdraw') ? 'active' : '' %>" href="/transactions/withdraw">
                <i class="bi bi-arrow-up-circle me-1"></i> Withdraw
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= currentPath.startsWith('/transactions/transfer') ? 'active' : '' %>" href="/transactions/transfer">
                <i class="bi bi-arrow-left-right me-1"></i> Transfer
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= currentPath === '/transactions' ? 'active' : '' %>" href="/transactions">
                <i class="bi bi-clock-history me-1"></i> History
              </a>
            </li>
          <% } else if (currUser.role === 'ADMIN') { %>
            <li class="nav-item">
              <a class="nav-link <%= currentPath.startsWith('/admin/users') ? 'active' : '' %>" href="/admin/users">
                <i class="bi bi-people me-1"></i> Users
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= currentPath.startsWith('/admin/accounts') ? 'active' : '' %>" href="/admin/accounts">
                <i class="bi bi-wallet2 me-1"></i> Accounts
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= currentPath.startsWith('/admin/transactions') ? 'active' : '' %>" href="/admin/transactions">
                <i class="bi bi-arrow-left-right me-1"></i> Transactions
              </a>
            </li>
          <% } else if (currUser.role === 'AUDITOR') { %>
            <li class="nav-item">
              <a class="nav-link <%= currentPath.startsWith('/auditor/accounts') ? 'active' : '' %>" href="/auditor/accounts">
                <i class="bi bi-wallet2 me-1"></i> Accounts
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= currentPath.startsWith('/auditor/ledger') ? 'active' : '' %>" href="/auditor/ledger">
                <i class="bi bi-journal-text me-1"></i> Immutable Ledger
              </a>
            </li>
          <% } %>
        <% } %>
      </ul>

      <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
        <% if (!currUser) { %>
          <li class="nav-item">
            <a class="nav-link fw-semibold" href="/auth/login">Sign In</a>
          </li>
          <li class="nav-item">
            <a class="btn btn-accent-ll px-3 py-1" href="/auth/register">Get Started</a>
          </li>
        <% } else { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <span class="badge rounded-pill bg-light text-dark border px-2 py-1"><i class="bi bi-person-fill me-1"></i> <%= currUser.username %></span>
              <span class="badge <%= currUser.role === 'ADMIN' ? 'badge-role-admin' : currUser.role === 'AUDITOR' ? 'badge-role-auditor' : 'badge-role-holder' %> small">
                <%= currUser.role %>
              </span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userMenu">
              <li><h6 class="dropdown-header"><%= currUser.fullName %></h6></li>
              <li><span class="dropdown-item-text text-muted small"><%= currUser.email %></span></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form action="/auth/logout" method="POST" class="d-inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="dropdown-item text-danger">
                    <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                  </button>
                </form>
              </li>
            </ul>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

