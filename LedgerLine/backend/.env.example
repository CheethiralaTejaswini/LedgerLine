# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# For single instance with replica set: mongodb://127.0.0.1:27017/ledgerline?replicaSet=rs0
# For local standard dev: mongodb://127.0.0.1:27017/ledgerline
MONGO_URL=mongodb://127.0.0.1:27017/ledgerline

# Session & Security
SESSION_SECRET=ledgerline_super_secure_session_secret_change_in_production
CSRF_SECRET=ledgerline_csrf_secure_token_secret_32char

# Payment Gateway (Razorpay Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

